Register the Dawning compositor as an in-kernel DRM client.

drm_client_setup dispatches to a fixed set of clients and there is no
exported way to enumerate DRM devices, so a client living outside
drivers/gpu/drm cannot attach itself. This adds "dawning" to that set,
alongside fbdev and log, and to the choice of default client.

Only reachable when CONFIG_DAWNING_DISPLAY is set, so a kernel built
without the compositor behaves exactly as it does upstream.

--- a/drivers/gpu/drm/clients/drm_client_setup.c
+++ b/drivers/gpu/drm/clients/drm_client_setup.c
@@ -11,6 +11,10 @@
 
 #include "drm_client_internal.h"
 
+#ifdef CONFIG_DAWNING_DISPLAY
+void dawning_display_register(struct drm_device *dev);
+#endif
+
 static char drm_client_default[16] = CONFIG_DRM_CLIENT_DEFAULT;
 module_param_string(active, drm_client_default, sizeof(drm_client_default), 0444);
 MODULE_PARM_DESC(active,
@@ -35,6 +39,13 @@ void drm_client_setup(struct drm_device *dev, const struct drm_format_info *forma
 		return;
 	}
 
+#ifdef CONFIG_DAWNING_DISPLAY
+	if (!strcmp(drm_client_default, "dawning")) {
+		dawning_display_register(dev);
+		return;
+	}
+#endif
+
 #ifdef CONFIG_DRM_FBDEV_EMULATION
 	if (!strcmp(drm_client_default, "fbdev")) {
 		int ret;
--- a/drivers/gpu/drm/clients/Kconfig
+++ b/drivers/gpu/drm/clients/Kconfig
@@ -88,7 +88,7 @@ config DRM_CLIENT_LOG
 choice
 	prompt "Default DRM Client"
 	depends on DRM_CLIENT_SELECTION
-	depends on DRM_FBDEV_EMULATION || DRM_CLIENT_LOG
+	depends on DRM_FBDEV_EMULATION || DRM_CLIENT_LOG || DAWNING_DISPLAY
 	default DRM_CLIENT_DEFAULT_FBDEV
 	help
 	  Selects the default drm client.
@@ -110,12 +110,20 @@ config DRM_CLIENT_DEFAULT_LOG
 	  screen, but doesn't implement a full terminal. For that you will need
 	  a userspace terminal using drm/kms.
 
+config DRM_CLIENT_DEFAULT_DAWNING
+	bool "dawning"
+	depends on DAWNING_DISPLAY
+	help
+	  Use the Dawning in-kernel compositor as the default drm client. It
+	  owns the display and draws the desktop, windows and cursor itself.
+
 endchoice
 
 config DRM_CLIENT_DEFAULT
        string
        depends on DRM_CLIENT
        default "fbdev" if DRM_CLIENT_DEFAULT_FBDEV
        default "log" if DRM_CLIENT_DEFAULT_LOG
+       default "dawning" if DRM_CLIENT_DEFAULT_DAWNING
        default ""
 
 endmenu
