#!/bin/sh
#
#       Emits the --wrap flags the replacement functions need.
#
#       Every file in src/replace defines __wrap_something. The linker turns
#       each call to that symbol into a call to ours, and leaves the original
#       reachable as __real_something -- so a replacement can decline and fall
#       through rather than having to reimplement what it replaced.
#
#       The flags are derived from the code rather than kept in a list beside
#       it, so adding a replacement is one file and nothing else.
#
set -u

[ -d src/replace ] || exit 0

grep -ho '__wrap_[A-Za-z0-9_]*' src/replace/*.c 2>/dev/null |
        sed 's/^__wrap_//' |
        sort -u |
        sed 's/^/--wrap=/' |
        tr '\n' ' '
