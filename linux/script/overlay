#!/bin/sh
#
#       Copies our versions of kernel files over the extracted tree.
#
#       src/linux mirrors the kernel's own layout, so src/linux/drivers/gpu/
#       drm/clients/drm_client_setup.c replaces the file of that name. Whole
#       files rather than diffs: a context patch stops applying the moment
#       upstream moves a line near the change, and rebasing one against a new
#       kernel is work every single bump.
#
#       The cost of owning a file instead is the opposite failure: the copy
#       keeps applying long after upstream has moved on, and nothing says so.
#       src/linux.overlay records the hash of the upstream file each of ours
#       was taken from, and this reports when they no longer match -- so an
#       overlay always applies, and always tells you when it needs a look.
#
#       Usage:
#           sh script/overlay            apply, reporting any drift
#           sh script/overlay --record   restamp the manifest after a review
#
set -u

. script/common

overlay_root="src/linux"
manifest="src/linux.overlay"
kernel_tree="linux"

[ -d "$overlay_root" ] || exit 0

record=0
[ "${1:-}" = "--record" ] && record=1

hash_of() {
        sha256sum "$1" 2>/dev/null | cut -d' ' -f1
}

recorded_hash() {
        [ -f "$manifest" ] || return 0
        awk -v want="$1" '$2 == want { print $1; exit }' "$manifest"
}

if [ "$record" -eq 1 ]; then
        : >"$manifest.new"
fi

drift=0
count=0

# -type f so the mirrored directories themselves are ignored.
for ours in $(find "$overlay_root" -type f | sort); do
        relative=${ours#"$overlay_root"/}
        theirs="$kernel_tree/$relative"

        if [ ! -f "$theirs" ]; then
                echo "$RED""overlay: $relative does not exist in this kernel""$RESET" >&2
                echo "It was probably moved or removed upstream." >&2
                exit 1
        fi

        upstream=$(hash_of "$theirs")

        if [ "$record" -eq 1 ]; then
                echo "$upstream  $relative" >>"$manifest.new"
        else
                expected=$(recorded_hash "$relative")

                if [ -z "$expected" ]; then
                        echo "$YELLOW""overlay: $relative has no recorded origin""$RESET" >&2
                        drift=$((drift + 1))
                elif [ "$expected" != "$upstream" ]; then
                        echo "$YELLOW""overlay: $relative changed upstream since it was taken""$RESET" >&2
                        drift=$((drift + 1))
                fi
        fi

        cp "$ours" "$theirs" || exit 1
        count=$((count + 1))
done

if [ "$record" -eq 1 ]; then
        mv "$manifest.new" "$manifest"
        echo "Recorded $count file(s) against $kernel_version."
        exit 0
fi

echo "Overlaid $count file(s)."

if [ "$drift" -gt 0 ]; then
        echo
        echo "$YELLOW$drift file(s) have moved on upstream.""$RESET"
        echo "Ours were still applied -- they always are -- but they no longer"
        echo "carry whatever changed. Diff them against the extracted tree,"
        echo "carry across what matters, then: sh script/overlay --record"
fi

# Drift is a prompt to look, not a reason to refuse to build.
exit 0
