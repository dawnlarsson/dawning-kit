#
# Debugging: none of it.
#
# CONFIG_EXPERT is what makes the rest of this file mean anything. A large
# number of kernel options are written
#
#       bool "Something" if EXPERT
#       default y
#
# which makes them invisible and forced on unless EXPERT is set -- and a
# fragment saying =n for an invisible symbol is discarded by olddefconfig
# without a word. Eleven of the options below were being ignored that way, so
# a kernel built from a profile named debug_none shipped SLUB_DEBUG,
# DEBUG_MEMORY_INIT and core dump support. script/verify_config now reports
# this rather than leaving it to be discovered.
#
CONFIG_EXPERT=y

CONFIG_PRINTK=y
CONFIG_TTY_PRINTK=y
CONFIG_PRINTK_TIME=n
CONFIG_TTY_PRINTK_LEVEL=2
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=2
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=2
CONFIG_CONSOLE_LOGLEVEL_QUIET=2

CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n

CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_SPLIT=n
CONFIG_DEBUG_INFO_DWARF4=n
CONFIG_DEBUG_INFO_BTF=n

# BUG stays. It buys nothing to remove: a BUG_ON is a trap instruction that
# costs nothing until it fires, and turning it off does not make the kernel
# faster, it makes it carry on quietly through a condition it knows is wrong.
# In a kernel we are actively changing that is a bad trade at any size saving.
CONFIG_BUG=y
CONFIG_CRASH_DUMP=n

CONFIG_FTRACE=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_SYMBOLIC_ERRNAME=n

CONFIG_KPROBES=n

# The unwinder choice belongs to the latency profile: on x86_64 the
# alternative to ORC is frame pointers, which is a runtime cost rather than a
# saving.

CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n
CONFIG_PANIC_ON_OOPS=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_IO_DELAY_0X80=n

CONFIG_STACKTRACE=n

# DEBUG_KERNEL is not a debug feature, it is a visibility switch, and EXPERT
# selects it on purpose -- "unhide debug options, to make the on-by-default
# options visible". It turns nothing on by itself; it is what lets the lines
# above turn things off. Asking for n only produces a warning that it cannot.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_MISC=n
CONFIG_FRAME_POINTER=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_LEGACY_VSYSCALL_NONE=n
CONFIG_ALLOW_DEV_COREDUMP=n
CONFIG_LEGACY_PTYS=n
CONFIG_LDISC_AUTOLOAD=n

CONFIG_SOFTLOCKUP_DETECTOR=n
CONFIG_HARDLOCKUP_DETECTOR=n

CONFIG_DEBUG_FS=n
CONFIG_DEBUG_VM=n
CONFIG_DEBUG_STACK_USAGE=n
CONFIG_DEBUG_LOCK_ALLOC=n
CONFIG_DEBUG_LOCKDEP=n
CONFIG_DEBUG_MUTEXES=n
CONFIG_DEBUG_SPINLOCK=n

CONFIG_BOOTTIME_TRACING=n
CONFIG_FUNCTION_TRACER=n
CONFIG_ENABLE_DEFAULT_TRACERS=n
CONFIG_PNP_DEBUG_MESSAGES=n

CONFIG_SLUB_DEBUG=n

# SLUB_TINY is a size option, not a speed one: it drops the per-cpu partial
# lists that make the fast path fast. It was being asked for and quietly not
# granted, which was the better outcome.
CONFIG_SLUB_TINY=n

# Both follow BUG, which is staying.
CONFIG_GENERIC_BUG=y
CONFIG_GENERIC_BUG_RELATIVE_POINTERS=y

# 70K of file names and line numbers to print when something has already gone
# wrong. It is image size rather than runtime, but a trap that reports the
# instruction pointer is enough to find the line it came from.
CONFIG_DEBUG_BUGVERBOSE=n

# all yes for prod
CONFIG_STRIP_ASM_SYMS=y
CONFIG_DEBUG_INFO_NONE=y
