lane_known()
{
        target_lane known_one
}


freestanding_checks_one()
{
        suite=$1
        source=$2
        name=$3
        cross=$4
        runner=$5

        if ! command -v "$cross" > /dev/null 2>&1; then
                note "$name: NOT RUN -- no $cross"
                return 2
        fi

        if [ -n "$runner" ] && ! command -v "$runner" > /dev/null 2>&1; then
                note "$name: NOT RUN -- no $runner"
                return 2
        fi

        saved=$compiler
        compiler=$cross
        freestanding "$source" "$work/$suite.$name" "$name" || {
                compiler=$saved
                return 1
        }
        compiler=$saved

        $runner "$work/$suite.$name" > "$work/$suite.$name.out" 2>&1
        status=$?

        if [ "$suite" = verify ]; then
                sed -n '/FAIL/p;/ABSENT/p;/under neither name here/p' \
                        "$work/$suite.$name.out"
        else
                sed -n '/FAIL/p' "$work/$suite.$name.out"
        fi

        line=$(sed -n 's/^\([0-9]*\) checks, \([0-9]*\) failures$/\1 \2/p' \
                "$work/$suite.$name.out")

        [ -n "$line" ] || { note "$name printed no verdict"; return 1; }

        checks=${line% *}
        bad=${line#* }

        tally "$suite-$name" "$((checks - bad))" "$checks"

        [ "$status" = 0 ] && [ "$bad" = 0 ]
}

freestanding_checks_lane()
{
        suite=$1
        source=$2
        target_lane freestanding_checks_one "$suite" "$source"
}

target_lane()
{
        check=$1
        shift
        failed=0
        missing=0

        for target in x86_64 arm64 riscv64; do
                target_tools "$target"
                outcome=0
                "$check" "$@" "$target" "$target_compiler" "$target_runner" ||
                        outcome=$?

                case $outcome in
                0) ;;
                2) missing=1 ;;
                *) failed=1 ;;
                esac
        done

        [ "$failed" = 0 ] || return 1
        [ "$missing" = 0 ] || return 2
        return 0
}

#
#       The byte order half is arithmetic and proves itself anywhere. The
#       socket half needs a loopback interface to bind to, which qemu-user
#       hands straight to the host kernel, so all three targets open real
#       sockets rather than only compiling the calls.
#
lane_socket() { freestanding_checks_lane socket src/test/socket.c; }

#
#       The message building half is arithmetic and proves itself anywhere.
#       The talking half reads the running kernel's link table, which any user
#       may do. Changing an interface needs privilege this may not have, so
#       the test attempts it and accepts the refusal -- run the lane under
#       `unshare -rn` and the same binary configures a real interface instead,
#       which is how the mutation path is actually covered.
#
lane_net() { freestanding_checks_lane net src/test/net.c; }


lane_slurp()
{
        freestanding_checks_lane slurp src/test/slurp.c
}

lane_wait()
{
        freestanding_checks_lane wait src/test/wait_retry.c
}

lane_writer()
{
        freestanding_checks_lane writer src/test/writer_buffer.c
}


#       arm64 assembly on an arm64 machine.
#
#       The verify lane runs the foreign two under qemu, and a Mac has no
#       qemu-user -- but a Mac is one of the three machines. AAPCS64 passes
#       arguments in x0-x7 on Darwin exactly as it does on Linux and none of
#       these routines makes a system call, so a body lifted out of the
#       library runs here unchanged.
#
#       src/test/native/run does the lifting directly out of the library that
#       ships. The compact rebuild passes library.next.c itself when it wants
#       to prove the generated candidate separately.
lane_native()
{
        if [ "$host_system" != Darwin ]; then
                note "native lifting needs Darwin, skipped"
                return 0
        fi

        case $(uname -m) in
        arm64 | aarch64) ;;
        *)
                note "not an arm64 machine, skipped"
                return 0
                ;;
        esac

        #       An arm64 machine is a fact about where this is running and
        #       says so above. A missing runner is not: it is the lane going
        #       away, on the one kind of machine that could have run it, and
        #       2 is how this file says a lane did not run.
        if [ ! -f src/test/native/run ]; then
                note "src/test/native/run is not here"
                return 2
        fi

        note "lifted out of src/library.c"

        if sh src/test/native/run src/library.c > "$work/native.out" 2>&1; then
                answered=0
        else
                answered=1
        fi

        sed 's/^/  /' "$work/native.out"

        counted=0

        sed -n 's/^\(.*\): \([0-9][0-9]*\) checks.*/\1|\2/p' "$work/native.out" |
                while IFS='|' read -r label total; do
                        slug=$(printf '%s' "$label" | tr ' ' '-')

                        if [ "$answered" = 0 ]; then
                                tally "$slug" "$total" "$total"
                        else
                                tally "$slug" 0 "$total"
                        fi
                done

        # A run that printed no verdict at all is a run that proved nothing,
        # which has to weigh something or it reads as a pass.
        grep -q ' checks' "$work/native.out" || counted=1

        [ "$answered" = 0 ] && [ "$counted" = 0 ]
}

#       spark.ld used to hide an RV64 process-entry ABI bug.  Its complete
#       layout did not relax small globals through gp, while the ordinary GNU
#       ELF script did; _start left the register at the kernel's unspecified
#       value and the first relaxed store went below address zero.  Build one
#       probe through that ordinary layout on purpose, then execute enough of
#       C startup to publish the environment and return through exit.
riscv_default_startup()
{
        startup_cross=riscv64-linux-gnu-gcc
        startup_runner=qemu-riscv64
        startup_image="$work/probe.riscv64-default"

        command -v "$startup_cross" > /dev/null 2>&1 || {
                note "RISC-V default-link startup: NOT RUN -- no $startup_cross"
                return 2
        }
        command -v "$startup_runner" > /dev/null 2>&1 || {
                note "RISC-V default-link startup: NOT RUN -- no $startup_runner"
                return 2
        }

        if ! "$startup_cross" -O2 -static -nostdlib -nostartfiles \
                -fno-stack-protector -fno-builtin \
                -march=rv64imafd_zicsr_zicntr -mabi=lp64d -w \
                -Wl,-e,_start -Wl,--build-id=none \
                -Wl,--no-warn-rwx-segments \
                -o "$startup_image" src/test/probe.c \
                2> "$work/probe.riscv64-default.err"
        then
                note "the ordinary RISC-V ELF startup probe did not build:"
                sed 's/^/    /' "$work/probe.riscv64-default.err" | head -10
                return 1
        fi

        if ! "$startup_runner" "$startup_image" status 0 \
                > "$work/probe.riscv64-default.out" 2>&1
        then
                note "the ordinary RISC-V ELF startup probe did not exit cleanly:"
                sed 's/^/    /' "$work/probe.riscv64-default.out" | head -10
                return 1
        fi

        [ ! -s "$work/probe.riscv64-default.out" ] || {
                note "the ordinary RISC-V ELF startup probe wrote unexpected output:"
                sed 's/^/    /' "$work/probe.riscv64-default.out" | head -10
                return 1
        }
}

lane_probe()
{
        failed=0

        freestanding src/test/probe.c "$work/probe" || return 1
        PROBE="$work/probe" sh src/test/probe.sh || failed=1

        startup_outcome=0
        riscv_default_startup || startup_outcome=$?
        case $startup_outcome in
        0) tally probe-riscv64-default-startup 1 1 ;;
        1)
                tally probe-riscv64-default-startup 0 1
                failed=1
                ;;
        2) ;;
        esac

        [ "$failed" = 0 ]
}

