# Moonwater canvas terminal, advertised as xterm-256color so a guest
# ncurses that already ships that name, and a native shell that does not,
# agree. The emulator is not a complete xterm; capabilities here are the
# ones the cells and the keys actually honour.
xterm-256color|moonwater|Moonwater 256-colour terminal,
	am, bce, km, mir, msgr, npc, xenl,
	colors#256, cols#80, it#8, lines#24, pairs#32767,
	acsc=++\,\,--..00``aaffgghhiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
	bel=^G, blink=\E[5m, bold=\E[1m, cbt=\E[Z,
	civis=\E[?25l, clear=\E[H\E[2J, cnorm=\E[?25h,
	cr=^M,
	csr=\E[%i%p1%d;%p2%dr,
	cub=\E[%p1%dD, cub1=^H,
	cud=\E[%p1%dB, cud1=\n,
	cuf=\E[%p1%dC, cuf1=\E[C,
	cup=\E[%i%p1%d;%p2%dH,
	cuu=\E[%p1%dA, cuu1=\E[A,
	dch=\E[%p1%dP, dch1=\E[P,
	dim=\E[2m,
	dl=\E[%p1%dM, dl1=\E[M,
	ech=\E[%p1%dX, ed=\E[J, el=\E[K, el1=\E[1K,
	enacs=\E(B\E)0,
	home=\E[H, hpa=\E[%i%p1%dG, ht=^I, hts=\EH,
	ich=\E[%p1%d@, ich1=\E[@,
	il=\E[%p1%dL, il1=\E[L,
	ind=\n, indn=\E[%p1%dS,
	invis=\E[8m,
	is2=\E[!p\E[?3;4l\E[4l\E>,
	kbs=\177,
	kcbt=\E[Z,
	kcub1=\EOD, kcud1=\EOB, kcuf1=\EOC, kcuu1=\EOA,
	kdch1=\E[3~, kend=\EOF, kent=\r, khome=\EOH,
	kich1=\E[2~,
	kmous=\E[<,
	knp=\E[6~, kpp=\E[5~,
	kLFT=\E[1;2D, kRIT=\E[1;2C,
	kind=\E[1;2B, kri=\E[1;2A,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
	kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
	kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
	op=\E[39;49m,
	rc=\E8, rev=\E[7m, ri=\EM, rin=\E[%p1%dT,
	ritm=\E[23m, rmacs=\E(B,
	rmcup=\E[?1049l\E[23;0;0t,
	rmir=\E[4l, rmkx=\E[?1l\E>, rmul=\E[24m,
	rmso=\E[27m,
	rs1=\Ec, rs2=\E[!p\E[?3;4l\E[4l\E>,
	sc=\E7,
	setab=\E[48;5;%p1%dm,
	setaf=\E[38;5;%p1%dm,
	sgr=%?%p9%t\E(0%e\E(B%;\E[0%?%p6%t;1%;%?%p5%t;2%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;%?%p7%t;8%;m,
