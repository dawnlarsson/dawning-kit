section screen

group gutter
same 'numbers'         '[1 ab]|[2 cd]|[3 ef]' 40 6 text 'ab\ncd\nef' row 0 row 1 row 2
same 'past the end'    '[~]'            40 6 text 'ab' row 1
same 'status line'     '0,7'            40 6 text 'ab' attr 5,0

group scroll
