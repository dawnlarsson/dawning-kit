#
# QEMU's arm64 "virt" machine.
#
# The arm/arm.pi profiles target a Raspberry Pi and bring no PL011 console, so
# an image built from them boots and says nothing. This adds what virt needs to
# be watched: the PL011 the machine exposes, and virtio-mmio for its devices.
#
CONFIG_ARCH_VIRT=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
