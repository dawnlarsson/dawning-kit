#!/bin/sh
set -e
. script/common

mkdir -p fs/sys
mkdir -p fs/proc
mkdir -p fs/dev

# mknod fails when the node already exists, which made every rebuild after the
# first noisy and, with set -e, fatal. Create each one only when missing.
make_node() {
        [ -e "$1" ] && return 0
        mknod "$1" "$2" "$3" "$4"
}

make_node fs/dev/tty     c 5 0
make_node fs/dev/console c 5 1
make_node fs/dev/null    c 1 3
make_node fs/dev/zero    c 1 5
make_node fs/dev/random  c 1 8
make_node fs/dev/urandom c 1 9

# /dev/spark is how userspace asks the kernel to spawn a program without
# forking first. The minor has to match SPARK_DEVICE_MINOR in standard/spark.h.
make_node fs/dev/spark   c 10 250
