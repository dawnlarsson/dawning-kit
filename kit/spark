#!/bin/sh
#
#       Compiles C to the flat spark format.
#
#       Usage: sh spark <source_without_extension> <output> [debug]
#
#       The layout is described in src/spark.c, which the kernel loader
#       includes too, so the two sides cannot drift apart. Every region is a
#       whole number of pages -- see kit/spark.ld for why.
#
set -u

. kit/common

# Found from this script's own directory rather than from the working one,
# which used to be assumed to be one level below the root and stopped being
# true the moment the tree was rearranged.
# shellcheck disable=SC1007
spark_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# The header is written with the kit's own byte primitives rather than a
# separate tool, which is the point of having them.
# shellcheck disable=SC1091
. "${KIT_DIR:-$spark_dir}/bit.sh"

SPARK_MAGIC=0x4b525053

if [ "$#" -lt 2 ]; then
        echo "spark: usage: spark <source_without_extension> <output> [debug]" >&2
        exit 1
fi

source_file="$1"
output="$2"
mode="${3:-}"

compiler=$(key_one compiler) || exit 1
arch=$(key_one arch) || exit 1

if [ -z "$arch" ]; then
        echo "spark: no '#> arch' in artifacts/.config" >&2
        exit 1
fi

#
#       binutils has to match the compiler, not the machine this runs on.
#
#       objdump, readelf and objcopy below all read the ELF the compiler just
#       produced. Building for another architecture with the host's copies gets
#       as far as
#
#           objcopy: Unable to recognise the architecture of the input file
#
#       so the prefix comes off the compiler's own name: aarch64-linux-gnu-gcc
#       means aarch64-linux-gnu-objcopy. A plain "gcc" leaves the prefix empty,
#       which is the native case and what was assumed before.
#
prefix=${compiler%gcc}
prefix=${prefix%clang}
prefix=${prefix%cc}

#
#       Prefer the matching tool, fall back to the host's. x86_64-linux-gnu-gcc
#       is a perfectly ordinary way to name a native compiler and there is
#       usually no x86_64-linux-gnu-objdump beside it, only objdump -- which is
#       the same program. Insisting on the prefix breaks the native build to fix
#       the cross one.
#
pick() {
        if command -v "$prefix$1" > /dev/null 2>&1; then
                echo "$prefix$1"
        elif command -v "$1" > /dev/null 2>&1; then
                echo "$1"
        else
                echo "spark: neither $prefix$1 nor $1 found" >&2
                return 1
        fi
}

objdump_cmd=$(pick objdump) || exit 1
readelf_cmd=$(pick readelf) || exit 1
objcopy_cmd=$(pick objcopy) || exit 1
program_flags=$(key program_flags)
spark_cppflags=${SPARK_CPPFLAGS:-}

if [ "$mode" = debug ]; then
        program_flags="$program_flags -g"
fi

linker_script="$spark_dir/spark.ld"

if [ ! -f "$linker_script" ]; then
        echo "spark: missing linker script at $linker_script" >&2
        exit 1
fi

label "$YELLOW""EXPERIMENTAL! C compiled to spark format"
echo "$BOLD""Compiling $output""$RESET"

work=$(mktemp -d "${TMPDIR:-/tmp}/spark.XXXXXXXX") || exit 1
elf="$work/image.elf"

cleanup() { rm -rf "$work"; }
trap cleanup EXIT INT TERM

# -flto discards the section layout the linker script depends on.
flags=$(printf '%s' "$program_flags" | sed 's/-flto//g')

# MOONWATER_FREESTANDING_ASM is what makes the .S assemble without the kernel
# headers; see kit/asm for why it is defined here rather than assumed there.
# shellcheck disable=SC2086
if ! $compiler "$source_file.c" -o "$elf" $flags $spark_cppflags \
        -static -nostdlib -nostartfiles \
        \
        -T "$linker_script" -Wl,--build-id=none -Wl,-e,_start \
        -Wl,--no-warn-rwx-segments; then
        echo "spark: compilation failed" >&2
        exit 1
fi

# objdump -h has a stable column layout; readelf -S splits "[ 1]" into two
# fields for single digit indices and one for double, which does not parse.
section_size() {
        "$objdump_cmd" -h "$elf" | awk -v s="$1" '$2 == s { print strtonum("0x" $3); exit }'
}

section_addr() {
        "$objdump_cmd" -h "$elf" | awk -v s="$1" '$2 == s { print strtonum("0x" $4); exit }'
}

page_round() { echo $((($1 + 4095) / 4096 * 4096)); }

# The image is mapped from 64 bytes before .text: that is where the header
# sits, and spark.ld reserves exactly that much.
text_addr=$(section_addr .text)
: "${text_addr:=0}"
base=$((text_addr - 64))
entry=$("$readelf_cmd" -h -W "$elf" | awk '/Entry point/ { print strtonum($NF) }')

data_addr=$(section_addr .data)
data_bytes=$(section_size .data)
bss_addr=$(section_addr .bss)
bss_bytes=$(section_size .bss)

: "${entry:=0}"
: "${data_addr:=0}" "${data_bytes:=0}" "${bss_addr:=0}" "${bss_bytes:=0}"

if [ "$text_addr" = 0 ] || [ "$entry" = 0 ]; then
        echo "spark: could not read base/entry from the linked image" >&2
        exit 1
fi

# A program need not have every section: duck has no .data at all. Text runs
# up to whichever region actually follows it, or to its own end if none does.
if [ "$data_bytes" -gt 0 ]; then
        text_end=$data_addr
elif [ "$bss_bytes" -gt 0 ]; then
        text_end=$bss_addr
else
        text_end=$((text_addr + $(section_size .text)))
fi

text_size=$(page_round $((text_end - base)))
data_size=$(page_round "$data_bytes")
bss_size=$(page_round "$bss_bytes")

if [ "$text_size" -le 0 ]; then
        echo "spark: computed a non positive text size ($text_size)" >&2
        exit 1
fi

"$objcopy_cmd" -O binary --only-section=.text "$elf" "$work/text.bin" || exit 1
"$objcopy_cmd" -O binary --only-section=.data "$elf" "$work/data.bin" 2>/dev/null || : >"$work/data.bin"

# Emits n zero bytes.
zeros() {
        dd if=/dev/zero bs=1 count="$1" 2>/dev/null
}

pad_file_to() {
        have=$(wc -c <"$1")
        if [ "$have" -lt "$2" ]; then
                zeros $(($2 - have)) || return 1
        fi
        return 0
}

spark_header() {
        bit_32 $SPARK_MAGIC
        bit_16 1
        bit_16 0
        bit_64 "$base"
        bit_64 "$entry"
        bit_64 "$text_size"
        bit_64 "$data_size"
        bit_64 "$bss_size"
        bit_64 0
        bit_64 0
}

{
        # The header occupies the first 64 bytes of the text region itself,
        # so the image carries no page that nothing maps.
        spark_header
        cat "$work/text.bin"
        pad_file_to "$work/text.bin" $((text_size - 64))

        if [ "$data_size" -gt 0 ]; then
                cat "$work/data.bin"
                pad_file_to "$work/data.bin" "$data_size"
        fi
} >"$output" || exit 1

chmod +x "$output"

printf 'spark: base=%#x entry=%#x text=%s data=%s bss=%s\n' \
        "$base" "$entry" "$text_size" "$data_size" "$bss_size"
size "$output"
echo
