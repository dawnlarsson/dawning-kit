#!/bin/sh
set -e
. kit/common

if [ "$#" -lt 1 ]; then
        echo "Usage: sh kit/config <profile1> [profile2] [profile3] ..." >&2
        echo "Example: sh kit/config any arch/x64 debug_none" >&2
        exit 1
fi

# A missing profile used to print a warning and carry on, producing a config
# silently missing whole feature sets. Check them all before writing anything.
missing=0
for profile in "$@"; do
        if [ ! -f "kernel/profile/$profile" ]; then
        echo "config: no such profile: profile/$profile" >&2
        missing=1
        fi
done

[ "$missing" -eq 0 ] || exit 1

echo "# Auto generated, do not edit." >artifacts/.config
cat artifacts/info >>artifacts/.config

for profile in "$@"; do
        echo "" >>artifacts/.config
        echo "Adding profile: $profile"
        cat "kernel/profile/$profile" >>artifacts/.config
done

#
#       Where two profiles disagree.
#
#       The profiles are concatenated into one fragment, so merge_config sees
#       a single file and can only compare it against the kernel's defaults --
#       it has no way to say that "gpu" and "console" asked for opposite
#       things. The last value written wins, silently. This is the only place
#       that comparison can be made.
#
conflicts=$(
        sed -n 's|^\(CONFIG_[A-Z0-9_]*\)=\(.*\)$|\1 \2|p' artifacts/.config |
                sort -u |
                awk '{ print $1 }' |
                uniq -d
)

if [ -n "$conflicts" ]; then
        echo
        echo "Profiles disagree -- the last value wins:"

        for option in $conflicts; do
                printf "  %s\n" "$option"

                for profile in "$@"; do
                        value=$(sed -n "s|^$option=\(.*\)\$|\1|p" "kernel/profile/$profile" | tail -1)
                        [ -n "$value" ] && printf "      %-14s %s\n" "$profile" "$value"
                done
        done

        echo
fi

echo "Configuration generated at artifacts/.config"
