#!/bin/sh
#
#       Runs a named benchmark suite on every architecture. With no name, the
#       hardware-floor audit is the useful default; the former byte-loop
#       comparison remains available as `baseline`.
#
#       The same freestanding link src/test/run uses, for the same reason: the
#       thing being measured is library.c's own assembly, and a libc in the
#       link would supply the very functions in question.
#
#       Foreign targets run under qemu. A qemu tick is the emulator's work and
#       not the machine's, so what comes out is a ratio worth reading and an
#       absolute number that is not. A Linux host target runs directly.
#
set -u

case ${1:-} in
"")      source_file=kit/floor.c ;;
baseline) source_file=kit/bench.c ;;
floor)   source_file=kit/floor.c ;;
numbers) source_file=kit/bench_numbers.c ;;
bases)   source_file=kit/bench_bases.c ;;
padded)  source_file=kit/bench_padded.c ;;
input-bases) source_file=kit/bench_parse_bases.c ;;
fields)  source_file=kit/bench_into_padded.c ;;
human)   source_file=kit/bench_human.c ;;
human-nearest) source_file=kit/bench_human_nearest.c ;;
hash-33) source_file=kit/bench_hash_33.c ;;
span-byte) source_file=kit/bench_span_byte.c ;;
fill-u32) source_file=kit/bench_fill_u32.c ;;
fill-u64) source_file=kit/bench_fill_u64.c ;;
paths)   source_file=kit/bench_paths.c ;;
reverse) source_file=kit/bench_reverse.c ;;
writer-field) source_file=kit/bench_writer_field.c ;;
writer-text) source_file=kit/bench_writer_text.c ;;
text-hot) source_file=kit/bench_text_hot.c ;;
prefix-known) source_file=kit/bench_prefix_known.c ;;
translate) source_file=kit/bench_translate.c ;;
ascii-case) source_file=kit/bench_ascii_case.c ;;
ascii-case-fold) source_file=kit/bench_ascii_case_fold.c ;;
line-break) source_file=kit/bench_line_break.c ;;
bounded-fold) source_file=kit/bench_bounded_fold.c ;;
ascii-convert) source_file=kit/bench_ascii_convert.c ;;
ascii-search) source_file=kit/bench_ascii_search.c ;;
grep-search) source_file=kit/bench_grep_search.c ;;
grep-count) source_file=kit/bench_grep_count.c ;;
last-of) source_file=kit/bench_last_of.c ;;
words) source_file=kit/bench_words.c ;;
clock) source_file=kit/bench_clock.c ;;
scan-literal) source_file=kit/bench_scan_literal.c ;;
random) source_file=kit/bench_random.c ;;
allocator) source_file=kit/bench_allocator.c ;;
reserve) source_file=kit/bench_reserve.c ;;
compare-max) source_file=kit/bench_compare_max.c ;;
string-copy) source_file=kit/bench_string_copy.c ;;
stream-get) source_file=kit/bench_stream_get.c ;;
stream-write) source_file=kit/bench_stream_write.c ;;
startup) source_file=kit/bench_startup.c ;;
*)       echo "bench: unknown lane; use floor, baseline, or another named benchmark" >&2; exit 2 ;;
esac

host_system=$(uname -s)
case $(uname -m) in
x86_64 | amd64) host_arch=x86_64 ;;
arm64 | aarch64) host_arch=arm64 ;;
riscv64)         host_arch=riscv64 ;;
*)               host_arch=unknown ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

run() {
        name=$1
        compiler=$2
        runner=$3

        case $name in
        arm64) architecture_flags=-mno-outline-atomics ;;
        riscv64) architecture_flags='-march=rv64imafd_zicsr_zicntr -mabi=lp64d' ;;
        *)     architecture_flags= ;;
        esac

        if ! command -v "$compiler" >/dev/null 2>&1; then
                echo "$name: NOT RUN -- no $compiler"
                return 2
        fi

        if [ -n "$runner" ] && ! command -v "$runner" >/dev/null 2>&1; then
                echo "$name: NOT RUN -- no $runner"
                return 2
        fi

        "$compiler" $architecture_flags \
                -O2 -static -nostdlib -nostartfiles -fno-stack-protector \
                -fno-builtin -T kit/spark.ld -Wl,-e,_start -Wl,--build-id=none \
                -Wl,--no-warn-rwx-segments \
                -o "$work/$name" "$source_file" || return 1

        if [ -n "$runner" ]; then
                echo "$name (emulated instruction shape; not hardware timing):"
        else
                echo "$name (native hardware):"
        fi
        if [ -z "$runner" ] && command -v taskset >/dev/null 2>&1; then
                taskset -c 0 "$work/$name"
        else
                $runner "$work/$name"
        fi
}

target_tools()
{
        target=$1

        if [ "$host_system" = Linux ] && [ "$host_arch" = "$target" ]; then
                target_compiler=${CC:-gcc}
                target_runner=
                return
        fi

        case $target in
        x86_64) target_compiler=x86_64-linux-gnu-gcc; target_runner=qemu-x86_64 ;;
        arm64)  target_compiler=aarch64-linux-gnu-gcc; target_runner=qemu-aarch64 ;;
        riscv64) target_compiler=riscv64-linux-gnu-gcc; target_runner=qemu-riscv64 ;;
        esac
}

failed=0
missing=0

for target in x86_64 arm64 riscv64; do
        target_tools "$target"
        outcome=0
        run "$target" "$target_compiler" "$target_runner" || outcome=$?

        case $outcome in
        0) ;;
        2) missing=1 ;;
        *) failed=1 ;;
        esac
done

[ "$failed" = 0 ] || exit 1

if [ "$missing" != 0 ]; then
        echo "bench: incomplete; every reported target above must run"
        exit 1
fi
