#!/bin/sh
#
#       Builds a freestanding binary, and optionally runs it.
#
#       Usage: sh build [-v] [--run] [--watch] [source_file] [output_file]
#
#           --run     run it once the build succeeds
#           --watch   rebuild and rerun on every change under the source tree
#
#       The size helpers come from kit/common, sourced from this script's own
#       directory rather than the working one: the point of this script is
#       building a file anywhere, and the working directory could be anything.
#
set -u

# shellcheck disable=SC1007
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$here/common"

verbose=false
do_run=false
do_watch=false
positional=""

while [ "$#" -gt 0 ]; do
        case "$1" in
        -v) verbose=true ;;
        --run) do_run=true ;;
        --watch) do_run=true; do_watch=true ;;
        --*) echo "build: unknown option $1" >&2; exit 1 ;;
        *) positional="$positional $1" ;;
        esac
        shift
done

# shellcheck disable=SC2086
set -- $positional

source_file=${1:-"src/main.c"}
output_file=${2:-"bin/$(basename "$(pwd)")"}

compiler=${CC:-gcc}

# This used to be built with flags_base+=" ...", which is a bash extension.
# Under dash -- /bin/sh on Debian and Ubuntu -- every append after the first
# silently failed, so the compiler ran without -O2 or any hardening flag.
# A single quoted assignment is POSIX and cannot partially apply.
flags_base="-static -s -flto -nostdlib -nostartfiles -ffreestanding -fno-builtin \
-Qn -Wl,--build-id=none -Wl,--gc-sections -Wl,--strip-all -Wl,--strip-debug -Wl,-x -Wl,-s \
-Wl,--no-warn-rwx-segments -Wl,-nmagic \
-O2 \
-fno-asynchronous-unwind-tables -fomit-frame-pointer -fno-stack-protector \
-fno-semantic-interposition -D_FORTIFY_SOURCE=0 -fno-unwind-tables -fno-plt \
-fno-PIE -fno-pie -fno-stack-clash-protection"

if [ ! -f "$source_file" ]; then
        echo "build: no such source file: $source_file" >&2
        exit 1
fi

compile() {
        mkdir -p "$(dirname "$output_file")" || return 1

        # shellcheck disable=SC2086
        "$compiler" "$source_file" -o "$output_file" $flags_base -Wl,-e,_start || {
                echo "build: compilation failed" >&2
                return 1
        }

        chmod +x "$output_file" || return 1

        if [ "$verbose" = true ]; then
                size "$output_file"
        fi
}

if [ "$do_watch" = false ]; then
        compile || exit 1

        [ "$do_run" = true ] || exit 0

        "$output_file"
        status=$?
        [ "$status" -eq 0 ] || echo "Exited with $status"
        exit "$status"
fi

#
#       Watching.
#
#       The pid of what was started is tracked rather than matched by name.
#       pkill -f on the output path used to match anything whose command line
#       merely contained it -- including this script and the watcher.
#
app_pid=""

stop_app() {
        [ -n "$app_pid" ] || return 0
        kill "$app_pid" 2>/dev/null
        wait "$app_pid" 2>/dev/null
        app_pid=""
}

trap 'stop_app; exit 0' INT TERM

rebuild() {
        stop_app
        clear

        if compile; then
                "$output_file" &
                app_pid=$!
        else
                echo "build: waiting for the next change" >&2
        fi
}

source_dir=$(dirname "$source_file")

if command -v inotifywait >/dev/null 2>&1; then
        watch() { inotifywait -q -m -r -e modify,create,delete,move "$source_dir"; }
elif command -v fswatch >/dev/null 2>&1; then
        watch() { fswatch -r "$source_dir"; }
else
        echo "build: --watch needs inotifywait (inotify-tools) or fswatch" >&2
        exit 1
fi

rebuild

watch | while read -r _; do
        rebuild
done
