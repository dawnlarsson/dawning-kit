#!/bin/sh
#
#       Builds a freestanding binary, and optionally runs it.
#
#       Usage: sh build [-v] [--run] [--watch] [source_file] [output_file]
#
#           --run     run it once the build succeeds
#           --watch   rebuild and rerun on every change under the source tree
#
#       The size helpers come from kit/common, sourced from this script's own
#       directory rather than the working one: the point of this script is
#       building a file anywhere, and the working directory could be anything.
#
set -u

# shellcheck disable=SC1007
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$here/common"

verbose=false
do_run=false
do_watch=false
positional=0
options=true
source_file=""
output_file=""

while [ "$#" -gt 0 ]; do
        if [ "$options" = true ]; then
                case "$1" in
                -v) verbose=true; shift; continue ;;
                --run) do_run=true; shift; continue ;;
                --watch) do_run=true; do_watch=true; shift; continue ;;
                --) options=false; shift; continue ;;
                --*) echo "build: unknown option $1" >&2; exit 1 ;;
                esac
        fi
        case $positional in
        0) source_file=$1 ;;
        1) output_file=$1 ;;
        *) echo "build: too many paths" >&2; exit 1 ;;
        esac
        positional=$((positional + 1))
        shift
done

[ "$positional" -ge 1 ] || source_file="src/main.c"
[ "$positional" -ge 2 ] || output_file="bin/$(basename "$(pwd)")"

# The compiler accepts a bare output filename; executing it must still refer
# to this directory rather than searching PATH for a different program.
case $output_file in
/* | ./* | ../*) ;;
*) output_file="./$output_file" ;;
esac

compiler=${CC:-gcc}
program_ipa_flags=
case $("$compiler" --version 2>/dev/null) in
*clang* | *Clang*) ;;
*GCC* | *gcc*)
        program_ipa_flags="-fwhole-program -fipa-pta"
        ;;
esac

# This used to be built with flags_base+=" ...", which is a bash extension.
# Under dash -- /bin/sh on Debian and Ubuntu -- every append after the first
# silently failed, so the compiler ran without -O2 or any hardening flag.
# A single quoted assignment is POSIX and cannot partially apply.
# -flto and the assembly in src/library.c do not get on: a routine written
# inside an asm string calls string_length, positive_to_string,
# decimal_to_string, file_new and working_directory by name, and the link time
# optimiser cannot see a call written inside a string, so on gcc 16 it drops
# all five and the link ends in undefined references. Marking each definition
# KEEP in library.c is what fixes it. Until then anything including library.c
# is built the way src/test/run builds it, without -flto.
#
# Close to profile/any's program_flags, which is the same list for the image's
# programs, and deliberately not identical. That one carries -ffunction-sections
# and -fdata-sections; this one does not need them, because kit/spark strips
# -flto (it discards the section layout its linker script depends on) and this
# keeps it, and LTO already collects what --gc-sections would. Checked: adding
# them changes the output by zero bytes, on a small program and on the test
# suite alike.
flags_base="-static -s -flto -nostdlib -nostartfiles -ffreestanding -fno-builtin \
-Qn -Wl,--build-id=none -Wl,--gc-sections -Wl,--strip-all -Wl,--strip-debug -Wl,-x -Wl,-s \
-Wl,--no-warn-rwx-segments -Wl,-nmagic \
-O2 $program_ipa_flags \
-fno-asynchronous-unwind-tables -fomit-frame-pointer -fno-stack-protector \
-fno-semantic-interposition -D_FORTIFY_SOURCE=0 -fno-unwind-tables -fno-plt \
-fno-PIE -fno-pie -fno-stack-clash-protection"

if [ ! -f "$source_file" ]; then
        echo "build: no such source file: $source_file" >&2
        exit 1
fi

compile() {
        mkdir -p "$(dirname "$output_file")" || return 1

        # shellcheck disable=SC2086
        "$compiler" "$source_file" -o "$output_file" $flags_base -Wl,-e,_start || {
                echo "build: compilation failed" >&2
                return 1
        }

        chmod +x "$output_file" || return 1

        if [ "$verbose" = true ]; then
                size "$output_file"
        fi
}

if [ "$do_watch" = false ]; then
        compile || exit 1

        [ "$do_run" = true ] || exit 0

        "$output_file"
        status=$?
        [ "$status" -eq 0 ] || echo "Exited with $status"
        exit "$status"
fi

#
#       Watching.
#
#       The pid of what was started is tracked rather than matched by name.
#       pkill -f on the output path used to match anything whose command line
#       merely contained it -- including this script and the watcher.
#
app_pid=""
watch_pid=""
watch_work=""

stop_app() {
        [ -n "$app_pid" ] || return 0
        kill "$app_pid" 2>/dev/null
        wait "$app_pid" 2>/dev/null
        app_pid=""
}

stop_watch() {
        stop_app
        if [ -n "$watch_pid" ]; then
                kill "$watch_pid" 2>/dev/null
                wait "$watch_pid" 2>/dev/null
                watch_pid=""
        fi
        if [ -n "$watch_work" ]; then
                rm -f "$watch_work/events"
                rmdir "$watch_work"
                watch_work=""
        fi
}

trap stop_watch EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rebuild() {
        stop_app
        clear

        if compile; then
                "$output_file" &
                app_pid=$!
        else
                echo "build: waiting for the next change" >&2
        fi
}

source_dir=$(dirname "$source_file")

if command -v inotifywait >/dev/null 2>&1; then
        watch() { exec inotifywait -q -m -r -e modify,create,delete,move "$source_dir"; }
elif command -v fswatch >/dev/null 2>&1; then
        watch() { exec fswatch -r "$source_dir"; }
else
        echo "build: --watch needs inotifywait (inotify-tools) or fswatch" >&2
        exit 1
fi

rebuild

# Keep the read/rebuild loop in this shell so its trap always owns the latest
# application PID. A pipeline put that state in a subshell and left both the
# replacement program and the watch process alive after termination.
watch_work=$(mktemp -d "${TMPDIR:-/tmp}/moonwater-watch.XXXXXXXX") || exit 1
mkfifo "$watch_work/events" || exit 1
watch > "$watch_work/events" &
watch_pid=$!
while IFS= read -r _; do
        rebuild
done < "$watch_work/events"
