#!/bin/sh
set -e
. kit/common

cpu_cores=$(nproc)

make_flags=$(key make_flags)

# The kernel used to be built with whatever arch/x86/Makefile chose, because
# nothing reached the C compiler. KCFLAGS is that gap closed.
kernel_cflags=$(key kernel_cflags)

kernel_image=$(key_one kernel_image)
kernel_export=$(key_one kernel_export)

if [ -z "$kernel_image" ] || [ -z "$kernel_export" ]; then
        echo "kernel_build: kernel_image / kernel_export not set in artifacts/.config" >&2
        exit 1
fi

cd linux || exit 1

# make's exit status was discarded, so a failed build still fell through to the
# copy below and shipped whatever image was left over from a previous run.
#
# KCPPFLAGS, KAFLAGS, LDFLAGS and RUSTFLAGS were passed here too, from keys no
# profile has ever set -- four empty variables handed to make on every build.
if ! make -j"$cpu_cores" $make_flags KCFLAGS="$kernel_cflags"; then
        echo "kernel_build: make failed" >&2
        exit 1
fi

cd ..

if [ ! -f "$kernel_image" ]; then
        echo "kernel_build: expected image '$kernel_image' was not produced" >&2
        exit 1
fi

mkdir -p "$(dirname "$kernel_export")"
sudo cp "$kernel_image" "$kernel_export"
