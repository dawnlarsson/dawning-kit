#
# Wireless LAN and Bluetooth
#
# Steam Deck LCD is Realtek RTL8822CE, OLED is MediaTek MT7921/MT7922.
# Both need linux-firmware blobs this repository does not carry -- the
# same rule as amdgpu. Copy the matching files into the image under
# /lib/firmware, or onto the data partition there. Without them the
# driver loads and the interface never appears.
#
#   rtw88/rtw8822c_fw.bin
#   rtw88/rtw8822c_wow_fw.bin
#   mediatek/WIFI_MT7961_patch_mcu_1_2_hdr.bin
#   mediatek/WIFI_RAM_CODE_MT7961_1.bin
#   rtl_bt/rtl8822cu_fw.bin
#   mediatek/BT_RAM_CODE_MT7961_1_2_hdr.bin
#
# Compose it with desktop (the default image already does):
#
#       sudo sh build.sh arch/x64 debug_none limbo desktop wifi serial
#
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n

CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=n
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=n
CONFIG_RFKILL=y

CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_CISCO=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_VIRTUAL=n
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_PCI=y
CONFIG_RTW88_8822C=y
CONFIG_RTW88_8822CE=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT76_CONNAC_LIB=y
CONFIG_MT792x_LIB=y
CONFIG_MT7921_COMMON=y
CONFIG_MT7921E=y

CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_INTEL=n
CONFIG_BT_BCM=n
CONFIG_BT_QCA=n
CONFIG_BT_MTK=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_RTL=y
CONFIG_BT_HIDP=y
