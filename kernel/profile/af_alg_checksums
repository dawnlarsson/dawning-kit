#
# Optional compatibility backend for the checksum applets
#
# Linux now describes AF_ALG as insecure, deprecated and retained only for
# compatibility.  It exposes kernel crypto implementations to unprivileged
# programs and has had a recurring vulnerability history, so this profile is
# deliberately never composed into `any` or another default image.
#
# Use it only on a controlled image that intentionally accepts that attack
# surface while the checksum applets are being migrated to a narrow
# Moonwater-owned fd-hash ABI.  Making algif_hash an autoloaded module is not
# a security boundary: an unprivileged AF_ALG socket can cause it to load.
#
# SHA-224 comes with SHA-256 and SHA-384 with SHA-512.  Only the hash adapter
# and the five required algorithm objects are selected; no cipher families.
#
CONFIG_CRYPTO=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_BLAKE2B=y
