#> program_flags -static -s -flto -nostdlib -nostartfiles -ffreestanding -fno-builtin
#> program_flags -ffunction-sections -fdata-sections
#> program_flags -Qn -Wl,--build-id=none -Wl,--gc-sections -Wl,--strip-all -Wl,--strip-debug -Wl,-x -Wl,-s
#> program_flags -O2 -Wl,-nmagic -fno-asynchronous-unwind-tables -fomit-frame-pointer -fno-stack-protector

#
# Any profile, essential for all
#

CONFIG_MOONWATER_CORE=y

CONFIG_INITRAMFS_SOURCE="../fs"

CONFIG_RD_GZIP=y
#
# Nine options were removed from this file because they could never take:
# GENERIC_IRQ_CHIP, GENERIC_IRQ_INJECTION, GENERIC_IRQ_STAT_SNAPSHOT,
# IRQ_SIM and IRQ_MSI_IOMMU are internal bools a driver selects and no
# fragment can set; ZONE_DEVICE and MEMORY_FAILURE need memory hotplug
# and machine check support that this kernel does not build; KEXEC_ELF
# follows KEXEC, which debug_none turns off on purpose; and KERNEL_GZIP
# is the other half of a choice already settled as zstd.
#
# They cost nothing except nine lines in verify_config's report on every
# build, which is how a check stops being read.
#
CONFIG_HAVE_KERNEL_GZIP=y
CONFIG_HAVE_KERNEL_ZSTD=y
CONFIG_KERNEL_ZSTD=y

CONFIG_UNIX=y

CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_FAIR_GROUP_SCHED=y

CONFIG_FW_LOADER=y
