#
# Hardware from the 2010s onward, and nothing before it
#
# The kernel carries a great deal for machines nobody here is going to boot,
# and most of it is behind a config option that defaults to on because a
# distribution kernel has to run everywhere. This turns that off. It is not a
# size exercise: some of it is paid on hot paths, every time, on hardware that
# has not needed it in fifteen years.
#
# The clearest of them is the LDT. With CONFIG_MODIFY_LDT_SYSCALL on,
# load_mm_ldt runs on every context switch, and for a process with no LDT --
# which is every process that is not Wine or dosemu -- it reaches:
#
#       xor  %eax, %eax
#       lldt %eax
#
# LLDT is microcoded and serialising. That is real money, per switch, for
# sixteen bit segments.
#
# The rest is either a second syscall entry path nothing will enter, tables no
# firmware written this century emits, or an ABI replaced before most of this
# hardware was made.
#
# Compose it last so it wins over anything that turned these on:
#
#       sh build.sh arch/x64 debug_none limbo desktop modern
#

# The LDT, and the lldt on every context switch that comes with it.
CONFIG_MODIFY_LDT_SYSCALL=n

# 32 bit userspace: a whole second syscall entry, a compat syscall table, and
# an in_compat_syscall() branch in a great many syscall implementations.
CONFIG_IA32_EMULATION=n

# The vsyscall page, which the vDSO replaced in 2008. Even XONLY keeps the
# mapping and the fault path that emulates it.
CONFIG_X86_VSYSCALL_EMULATION=n

# ioperm and iopl: handing userspace direct port access, and a bitmap to
# switch with it.
CONFIG_X86_IOPL_IOPERM=n

# MP tables, which is how a machine described its processors before ACPI.
CONFIG_X86_MPPARSE=n

#
# The second kind, found by ranking rather than by reading
#
# Booting with initcall_debug and sorting gives 639 ms across 1114 initcalls,
# and the top of the list is mostly things this image will never use. These
# are the ones removable without argument: a timer the TSC replaced, the
# enumeration bus ACPI replaced, a block device nothing here loops, and the
# half of the network stack nothing here speaks.
#
#       5682 us   init_acpi_pm_clocksource
#       6000 us   loop_init
#       2071 us   pnpacpi_init
#       1859 us   inet6_init
#
# i8042 (4932 us) and usb_init (2000 us) are deliberately left in. They are
# just as legacy, and a real machine still boots with a keyboard on one and a
# disk on the other.

# The ACPI power management timer. The TSC is the clocksource on anything
# this targets; the PM timer is what was used before it was trustworthy.
CONFIG_X86_PM_TIMER=n

# Plug and Play, which is how a card announced itself before PCI did.
CONFIG_PNP=n

# Loopback block devices.
CONFIG_BLK_DEV_LOOP=n

# IPv6.
CONFIG_IPV6=n

#
# The second turn of the same loop
#
# Re-ranking after the first round moves these to the top. acpi_init stays at
# 55000 us and is not going anywhere -- the gap in the log is acpi_scan_init
# walking the namespace, and much of it is not code at all: ACPI registers are
# port I/O, every port access is an exit, and this is measured in a virtual
# machine. The same caveat applies to pci_apply_final_quirks and
# pcibios_assign_resources, which is why neither is touched here.
#
#       2323 us   load_system_certificate_list
#       2270 us   acpi_button_init
#       1394 us   igb_init_module
#       1255 us   brd_init
#       1155 us   igc_init_module

# The signing keyring, for modules this image does not load.
CONFIG_SYSTEM_TRUSTED_KEYRING=n

# The ACPI power button. Nothing here is switched off by pressing one; the
# shell says poweroff and the kernel takes S5 from there.
CONFIG_ACPI_BUTTON=n

# RAM block devices.
CONFIG_BLK_DEV_RAM=n

# Intel gigabit parts that exist on real boards and not in this machine. e1000
# stays: it is what qemu presents by default, and taking it would mean the
# image had no network at all rather than one card fewer.
CONFIG_IGB=n
CONFIG_IGC=n

#
# The network card a virtual machine actually presents
#
# The build had E1000E, which drives 82574 and later over PCIe. qemu presents
# an 82540EM -- [8086:100e], conventional PCI -- which wants E1000. So the
# device sat on the bus unclaimed and the guest saw one interface, lo, while
# the whole stack was up and waiting: PF_INET, PF_NETLINK, PF_ROUTE and
# PF_PACKET all registered, /proc/net fully populated, and nothing to talk to.
CONFIG_E1000=y
