#!/bin/sh
#
#       Rebuild and rerun on every source change.
#
#       Usage: sh dev [-v] [source_file] [output_file]
#       Requires inotifywait (inotify-tools) on Linux, or fswatch on macOS.
#
set -u

# Prefer this checkout over the /standard symlink, so the script works from a
# plain clone without localinstall.sh having been run.
# shellcheck disable=SC1007 # CDPATH= is a deliberate one-shot empty assignment
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build="$here/build"
[ -f "$build" ] || build=/standard/build

verbose=""
if [ "${1:-}" = "-v" ]; then
        verbose="-v"
        shift
fi

source_file=${1:-"src/main.c"}
output_file=${2:-"bin/$(basename "$(pwd)")"}
source_dir=$(dirname "$source_file")

app_pid=""

stop_app() {
        [ -n "$app_pid" ] || return 0
        kill "$app_pid" 2>/dev/null
        wait "$app_pid" 2>/dev/null
        app_pid=""
}

cleanup() {
        stop_app
        exit 0
}

trap cleanup INT TERM

rebuild() {
        stop_app
        clear

        if sh "$build" $verbose "$source_file" "$output_file"; then
                "$output_file" &
                app_pid=$!
        else
                echo "dev: build failed, waiting for the next change" >&2
        fi
}

# pkill -f "$output_file" matched any process whose command line merely
# contained the path -- including this script and the watcher. Tracking the
# pid we actually started is exact.
if command -v inotifywait >/dev/null 2>&1; then
        watch() { inotifywait -q -m -r -e modify,create,delete,move "$source_dir"; }
elif command -v fswatch >/dev/null 2>&1; then
        watch() { fswatch -r "$source_dir"; }
else
        echo "dev: needs inotifywait (inotify-tools) or fswatch to watch for changes" >&2
        exit 1
fi

rebuild

watch | while read -r _; do
        rebuild
done
